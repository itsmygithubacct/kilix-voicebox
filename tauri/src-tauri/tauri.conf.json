{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voicebox",
  "version": "0.1.12",
  "identifier": "sh.voicebox.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "sh -euc 'root=$PWD; while [ ! -f \"$root/tools/tauri_build_gate.py\" ]; do if [ \"$root\" = / ]; then echo \"voicebox: sidecar gate not found\" >&2; exit 1; fi; root=$(dirname \"$root\"); done; python3 -I \"$root/tools/tauri_build_gate.py\" && bun run build'",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/voicebox-server"],
    "resources": {
      "resources/sidecar/RESOURCES.json": "sidecar/RESOURCES.json",
      "resources/sidecar/licenses/kilix-transcribe/LICENSE": "sidecar/licenses/kilix-transcribe/LICENSE",
      "resources/sidecar/licenses/kilix-voice/LICENSE": "sidecar/licenses/kilix-voice/LICENSE",
      "resources/sidecar/voicebox-server.provenance.json": "sidecar/voicebox-server.provenance.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:17493 ws://127.0.0.1:5173; img-src 'self' asset: http://asset.localhost http://127.0.0.1:17493 data: blob:; media-src 'self' asset: http://asset.localhost http://127.0.0.1:17493 data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["default"]
    },
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "userAgent": null,
        "titleBarStyle": "Overlay"
      }
    ],
    "withGlobalTauri": false
  }
}
